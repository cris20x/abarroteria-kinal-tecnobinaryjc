<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane minHeight="520.0" minWidth="760.0" prefHeight="620.0" prefWidth="920.0" stylesheets="@../css/login-view.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.tecnobinaryjc.abarroteria.kinal.controller.LoginController">
    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" styleClass="auth-root">
            <VBox alignment="CENTER" maxWidth="430.0" prefWidth="430.0" spacing="18.0" styleClass="auth-card">
                <ImageView fitHeight="135.0" fitWidth="180.0" preserveRatio="true">
                    <image><Image url="@../img/4d2d5522-5c6e-4d37-b68a-9d91afb6c3fc.png"/></image>
                </ImageView>
                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="Bienvenido" styleClass="auth-title"/>
                    <Label text="Inicia sesión para continuar" styleClass="auth-subtitle"/>
                </VBox>
                <VBox spacing="8.0">
                    <Label text="Correo electrónico" styleClass="field-label"/>
                    <TextField fx:id="txtFieldEmail" promptText="correo@ejemplo.com" styleClass="input-field"/>
                </VBox>
                <VBox spacing="8.0">
                    <Label text="Contraseña" styleClass="field-label"/>
                    <PasswordField fx:id="txtFieldPassword" promptText="Ingresa tu contraseña" styleClass="input-field" onAction="#handleLogin"/>
                </VBox>
                <HBox alignment="CENTER" spacing="12.0">
                    <Button fx:id="btnIniciarSesion" mnemonicParsing="false" onAction="#handleLogin" prefHeight="44.0" text="Iniciar sesión" styleClass="primary-button" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#handleRegistrar" prefHeight="44.0" text="Registrarse" styleClass="secondary-button" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </StackPane>
    </children>
</AnchorPane>

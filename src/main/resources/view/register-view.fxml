                        <String fx:value="btn-third" />
                        <String fx:value="btn-word" />
                     </styleClass>
                  </Button>
                  <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleVolver" prefHeight="42.0" prefWidth="115.0" stylesheets="@../css/button-style.css" text="Volver">

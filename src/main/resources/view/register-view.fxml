            <TextField fx:id="txtFieldApellido" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Correo electrónico" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtFieldEmail" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Contraseña" GridPane.columnIndex="0" GridPane.rowIndex="3" />

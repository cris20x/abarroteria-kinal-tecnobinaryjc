<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane minHeight="600.0" minWidth="760.0" prefHeight="680.0" prefWidth="920.0" stylesheets="@../css/login-view.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.tecnobinaryjc.abarroteria.kinal.controller.RegisterController">
    <children>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <StackPane minHeight="600.0" styleClass="auth-root">
                    <VBox alignment="CENTER" maxWidth="560.0" prefWidth="560.0" spacing="15.0" styleClass="auth-card">
                        <VBox alignment="CENTER" spacing="5.0">
                            <Label text="Crear cuenta" styleClass="auth-title"/>
                            <Label text="Completa los datos para registrarte" styleClass="auth-subtitle"/>
                        </VBox>
                        <GridPane hgap="14.0" vgap="12.0">
                            <columnConstraints><ColumnConstraints percentWidth="50.0"/><ColumnConstraints percentWidth="50.0"/></columnConstraints>
                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0"><Label text="Nombre" styleClass="field-label"/><TextField fx:id="txtFieldNombre" promptText="Tu nombre" styleClass="input-field"/></VBox>
                            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label text="Apellido" styleClass="field-label"/><TextField fx:id="txtFieldApellido" promptText="Tu apellido" styleClass="input-field"/></VBox>
                            <VBox spacing="6.0" GridPane.columnSpan="2" GridPane.rowIndex="1"><Label text="Correo electrónico" styleClass="field-label"/><TextField fx:id="txtFieldEmail" promptText="correo@ejemplo.com" styleClass="input-field"/></VBox>
                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2"><Label text="Contraseña" styleClass="field-label"/><PasswordField fx:id="txtFieldPassword" promptText="Mínimo 6 caracteres" styleClass="input-field"/></VBox>
                            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2"><Label text="Confirmar contraseña" styleClass="field-label"/><PasswordField fx:id="txtFieldConfirmPassword" promptText="Repite tu contraseña" styleClass="input-field"/></VBox>
                            <VBox spacing="6.0" GridPane.columnSpan="2" GridPane.rowIndex="3"><Label text="Rol" styleClass="field-label"/><ComboBox fx:id="comboBoxRol" prefHeight="42.0" promptText="Selecciona un rol" styleClass="input-field"/></VBox>
                        </GridPane>
                        <HBox alignment="CENTER" spacing="12.0">
                            <Button mnemonicParsing="false" onAction="#handleRegistrar" prefHeight="44.0" text="Registrarme" styleClass="primary-button" HBox.hgrow="ALWAYS"/>
                            <Button mnemonicParsing="false" onAction="#handleVolver" prefHeight="44.0" text="Volver" styleClass="secondary-button" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

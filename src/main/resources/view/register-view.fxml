<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane minHeight="600.0"
            minWidth="760.0"
            prefHeight="680.0"
            prefWidth="920.0"
            stylesheets="@../css/login-view.css"
            styleClass="register-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.java.com.tecnobinaryjc.abarroteria.kinal.controller.RegisterController">

    <children>

        <StackPane AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0"
                   styleClass="auth-root">

            <VBox alignment="CENTER"
                  maxWidth="560.0"
                  prefWidth="560.0"
                  spacing="15.0"
                  styleClass="auth-card">

                <!-- ENCABEZADO -->

                <StackPane prefHeight="120.0"
                           maxWidth="520.0"
                           styleClass="register-header">

                    <HBox alignment="CENTER_LEFT"
                          spacing="18.0">

                        <VBox alignment="CENTER_LEFT"
                              spacing="5.0"
                              HBox.hgrow="ALWAYS">

                            <Label text="Crea una nueva cuenta en"
                                   styleClass="register-title"/>

                            <Label text="Completa los datos que se solicitan para Registrarte"
                                   styleClass="register-subtitle"/>

                        </VBox>

                        <ImageView fitWidth="90.0"
                                   fitHeight="90.0"
                                   preserveRatio="true"
                                   smooth="true">

                            <image>
                                <Image url="@../img/LogoAbarroteriaTCBinary.png"/>
                            </image>

                        </ImageView>

                    </HBox>

                </StackPane>

                <!-- FORMULARIO -->

                <GridPane hgap="14.0"
                          vgap="12.0">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0"/>
                        <ColumnConstraints percentWidth="50.0"/>
                    </columnConstraints>

                    <!-- NOMBRE -->

                    <VBox spacing="6.0"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="0">

                        <Label text="Nombre"
                               styleClass="field-label"/>

                        <TextField fx:id="txtFieldNombre"
                                   promptText="Tu nombre"
                                   styleClass="input-field"/>

                    </VBox>

                    <!-- APELLIDO -->

                    <VBox spacing="6.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0">

                        <Label text="Apellido"
                               styleClass="field-label"/>

                        <TextField fx:id="txtFieldApellido"
                                   promptText="Tu apellido"
                                   styleClass="input-field"/>

                    </VBox>

                    <!-- CORREO -->

                    <VBox spacing="6.0"
                          GridPane.columnSpan="2"
                          GridPane.rowIndex="1">

                        <Label text="Correo electrónico"
                               styleClass="field-label"/>

                        <HBox spacing="8.0"
                              alignment="CENTER_LEFT">

                            <TextField fx:id="txtFieldEmail"
                                       promptText="ejemplo.123"
                                       styleClass="input-field"
                                       HBox.hgrow="ALWAYS"/>

                            <ComboBox fx:id="comboBoxExtension"
                                      prefHeight="42.0"
                                      prefWidth="150.0"
                                      styleClass="input-field"/>

                        </HBox>

                    </VBox>

                    <!-- CONTRASEÑA -->

                    <VBox spacing="6.0"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="2">

                        <Label text="Contraseña"
                               styleClass="field-label"/>

                        <PasswordField fx:id="txtFieldPassword"
                                       promptText="Mínimo 6 caracteres"
                                       styleClass="input-field"/>

                    </VBox>

                    <!-- CONFIRMAR CONTRASEÑA -->

                    <VBox spacing="6.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2">

                        <Label text="Confirmar contraseña"
                               styleClass="field-label"/>

                        <PasswordField fx:id="txtFieldConfirmPassword"
                                       promptText="Confirma tu contraseña"
                                       styleClass="input-field"/>

                    </VBox>

                    <!-- ROL -->

                    <VBox spacing="6.0"
                          GridPane.columnSpan="2"
                          GridPane.rowIndex="3">

                        <Label text="Tu cuenta será:"
                               styleClass="field-label"/>

                        <ComboBox fx:id="comboBoxRol"
                                  prefHeight="42.0"
                                  promptText="Tu cuenta será de:"
                                  styleClass="input-field"/>

                    </VBox>

                </GridPane>

                <!-- BOTONES -->

                <HBox alignment="CENTER"
                      spacing="12.0">

                    <Button mnemonicParsing="false"
                            onAction="#handleRegistrar"
                            prefHeight="44.0"
                            text="Registrarme"
                            styleClass="primary-button"
                            HBox.hgrow="ALWAYS"/>

                    <Button mnemonicParsing="false"
                            onAction="#handleVolver"
                            prefHeight="44.0"
                            text="Volver"
                            styleClass="secondary-button"
                            HBox.hgrow="ALWAYS"/>

                </HBox>

            </VBox>

        </StackPane>

    </children>

</AnchorPane>